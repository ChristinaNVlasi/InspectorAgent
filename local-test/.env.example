# ─────────────────────────────────────────────────────────────────────────────
#  SMA Inspector — Local Environment Configuration
#  Copy this file to apps/.env and fill in your values:
#    cp local-test/.env.example apps/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── MCP Security Token ────────────────────────────────────────────────────────
# A cryptographically random secret shared by all services.
# Leave blank — start.sh will auto-generate one on first run.
MCP_API_TOKEN=

# ── LLM Backend ──────────────────────────────────────────────────────────────
# Shared office inference server (requires VPN if working remotely).
# To use a local Ollama instead, change to http://localhost:11434/v1
LM_STUDIO_API_BASE=http://20.10.10.152:11434/v1
LM_STUDIO_MODEL=openai/qwen3:30b-a3b-q8_0
LM_STUDIO_API_KEY=ollama

# ── Agent URLs (leave as-is for single-machine local run) ────────────────────
MCP_SERVER_URL=http://localhost:3030
KNORR_AGENT_URL=http://localhost:2829
ARCELIK_AGENT_URL=http://localhost:2828
BORG_AGENT_URL=http://localhost:2827

# ── Optional overrides ────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# DEPOSIT_AMOUNT=100.00
# MIN_VIDEO_DURATION_SEC=2.0
